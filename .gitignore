# macOS
.DS_Store

# Agent scratch: throwaway git worktrees created by subagents
.claude/worktrees/

# Machine-local Claude Code settings
.claude/settings.local.json

# Debug symbol bundles
*.dSYM/

# Compiled tool output. Sources only — the build lines live in
# tools/native-probe/FINDINGS.md and tools/compat-enabler/build.sh.
tools/native-probe/*
!tools/native-probe/*.cpp
!tools/native-probe/*.h
!tools/native-probe/*.md

tools/compat-enabler/*
!tools/compat-enabler/*.c
!tools/compat-enabler/*.h
!tools/compat-enabler/*.md
!tools/compat-enabler/build.sh

tools/seam-spike/*
!tools/seam-spike/*.c
!tools/seam-spike/*.cpp
!tools/seam-spike/*.h
!tools/seam-spike/*.py
!tools/seam-spike/*.md
!tools/seam-spike/build.sh
!tools/seam-spike/run.sh

tools/harness/build/
tools/harness/build32/

tools/shimprobe/steamclient64.dll
tools/shimprobe/shimprobe.log
tools/shim/dist/

tools/overlay-probe/*
!tools/overlay-probe/*.m
!tools/overlay-probe/*.c
!tools/overlay-probe/*.h
!tools/overlay-probe/*.md
!tools/overlay-probe/build.sh
!tools/overlay-probe/input-parity-run.sh

tools/overlay-inject/dist/
