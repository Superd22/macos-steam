# macOS
.DS_Store

# Agent scratch: throwaway git worktrees created by subagents
.claude/worktrees/

# Machine-local Claude Code settings
.claude/settings.local.json

# Debug symbol bundles
*.dSYM/

# Compiled tool output. Sources only — the build lines live in
# instruments/native-probe/FINDINGS.md and src/compat-enabler/build.sh.
src/compat-enabler/*
!src/compat-enabler/*.c
!src/compat-enabler/*.h
!src/compat-enabler/*.md
!src/compat-enabler/build.sh

src/shim/dist/
src/overlay-inject/dist/

# Generated deploy contract (#32) — src/layout/layout.json is the source.
src/layout/gen/

# Generated thunks (#78) — src/shim/vtables.json + overrides.json are the source,
# and build.sh re-derives all of it on every build, so a checked-in copy could
# only ever be a stale one. REPORT.md is the exception: it is the record of what
# the generator REFUSED to emit and why, which has to be readable without a
# toolchain and reviewable in a diff.
src/shim/gen/*
!src/shim/gen/REPORT.md

instruments/native-probe/*
!instruments/native-probe/*.cpp
!instruments/native-probe/*.h
!instruments/native-probe/*.md

instruments/overlay-probe/*
!instruments/overlay-probe/*.c
!instruments/overlay-probe/*.h
!instruments/overlay-probe/*.md
!instruments/overlay-probe/build.sh
!instruments/overlay-probe/input-parity-run.sh

instruments/harness/build/
instruments/harness/build32/

attic/native-probe/*
!attic/native-probe/*.cpp
!attic/native-probe/*.h
!attic/native-probe/*.md

attic/overlay-probe/*
!attic/overlay-probe/*.m
!attic/overlay-probe/*.c
!attic/overlay-probe/*.h
!attic/overlay-probe/*.md
!attic/overlay-probe/build.sh

attic/seam-spike/*
!attic/seam-spike/*.c
!attic/seam-spike/*.cpp
!attic/seam-spike/*.h
!attic/seam-spike/*.py
!attic/seam-spike/*.md
!attic/seam-spike/build.sh
!attic/seam-spike/run.sh

attic/shimprobe/steamclient64.dll
attic/shimprobe/shimprobe.log

# Python bytecode
__pycache__/

# Staged install payloads (#34) — src/installer/build.sh output.
src/installer/dist/

# Compiled launcher (#42).
src/launcher/dist/
